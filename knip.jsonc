{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Entry files are named here, not found by guessing, so a file nothing imports is reported.
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.ts"],
      "project": ["e2e/**/*.ts", "*.ts", "*.js"],
    },
    "client": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
    },
    "server": {
      "entry": ["src/server.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "*.ts"],
    },
  },
}
