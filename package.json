{
  "name": "grilled-heads-up",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server && tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test -w client && npm run test -w server",
    "test:e2e": "npm run build && playwright test",
    "test:mutation": "npm run test:mutation -w client",
    "lint:eslint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "qs": "^6.16.0",
    "vitest": "^4.1.11"
  }
}
